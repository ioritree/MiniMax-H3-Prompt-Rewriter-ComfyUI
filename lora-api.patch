+#: The name this adapter is registered under in the modern adapter API.
+LORA_NAME = "minimax_h3_prompt_rewriter"
+
+#: Set on a loaded ``Llama`` when the adapter has to be named on every call.
+LORA_ATTR = "_minimax_h3_lora"
+
+
+def _lora_api(llama_cpp) -> str:
+    """Which adapter API this llama-cpp-python has: 'modern', 'legacy' or ''.
+
+    Worth checking rather than assuming, because the failure this guards against
+    is silent. 0.3.47 dropped ``lora_path`` from ``Llama.__init__`` in favour of
+    ``load_lora`` plus a per-call ``active_loras``, and the same release grew a
+    ``**kwargs`` that is declared and never read -- so ``Llama(lora_path=...)``
+    is accepted, discarded, and the rewriter runs as a plain base model with no
+    error anywhere. A ``TypeError`` guard cannot catch that; only asking what the
+    signature really accepts can.
+    """
+    if hasattr(llama_cpp.Llama, "load_lora"):
+        return "modern"
+    parameters = inspect.signature(llama_cpp.Llama.__init__).parameters
+    accepted = parameters.get("lora_path")
+    if accepted is not None and accepted.kind is not accepted.VAR_KEYWORD:
+        return "legacy"
+    return ""
+
+
