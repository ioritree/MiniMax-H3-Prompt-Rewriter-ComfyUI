+def _release_loras(llama) -> None:
+    """Free adapters while the base model is still alive.
+
+    ``LlamaModel.close`` in 0.3.47 calls ``llama_model_free`` first and only then
+    walks its adapter registry, so ``llama_adapter_lora_free`` runs against a
+    model that is already gone -- an access violation that takes the ComfyUI
+    process's worker thread with it. The adapters hold references into the
+    model's own structures, so the order matters and it is the wrong way round.
+
+    Freeing them here, before ``close``, leaves an empty registry for that branch
+    to skip. Everything downstream is safe to run twice: ``LlamaLoraAdapter.free``
+    guards on its own pointer, so the ``_exit_stack`` callback and ``__del__``
+    both become no-ops.
+
+    Only reachable when an adapter is attached, which is why nobody met it while
+    ``lora_path`` was being silently discarded.
+    """
+    release = getattr(llama, "unload_all_loras", None)
+    if not callable(release):
+        return
+    try:
+        release()
+    except Exception:
+        log.debug("[minimax_h3_rewriter.gguf._release_loras] failed", exc_info=True)
+
+
